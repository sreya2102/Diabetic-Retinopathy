# ============================================================
# RETINASCAN - Git Ignore
# ============================================================

# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual environments
.venv/
venv/
ENV/
env/

# Environment variables & secrets
.env
.env.*
.streamlit/secrets.toml

# Testing & coverage
.pytest_cache/
.coverage
htmlcov/

# Jupyter Notebooks
.ipynb_checkpoints/

# ============================================================
# Datasets - Do NOT commit patient/medical data
# ============================================================
data/raw/
data/processed/
data/annotations/
data/splits/

# Dataset/archive files
*.zip
*.tar
*.tar.gz
*.gz
*.csv
*.h5

# ============================================================
# Model weights - Do NOT commit large model files
# ============================================================
models/*.pt
models/*.pth
models/*.onnx
models/*.h5
models/*.bin
models/*.ckpt

# ============================================================
# Generated reports and temporary outputs
# ============================================================
reports/generated/*
!reports/generated/.gitkeep

logs/
temp/
*.tmp
*.log

# ============================================================
# Generated images / exports
# ============================================================
*.png
*.jpg
*.jpeg
*.svg

# ============================================================
# IDE & Editor files
# ============================================================
.vscode/
.idea/
*.swp
*.swo

# ============================================================
# Operating system files
# ============================================================
.DS_Store
Thumbs.db